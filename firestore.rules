rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPhoneVerifiedOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.phone_number is string
        && request.auth.token.phone_number.size() >= 10;
    }

    function isValidCustomerProfile(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'phoneVerified', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'phone', 'phoneVerified', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() >= 10
        && data.phone.size() <= 16
        && data.phone.matches('^\\+?[0-9]{10,15}$')
        && data.phoneVerified is bool
        && data.phoneVerified == true
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Startup connectivity check document
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Admin lookup collection (server/console-managed only)
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Customer profiles: PII isolated to verified phone owner or admin
    match /customers/{uid} {
      allow get: if isValidId(uid) && (isPhoneVerifiedOwner(uid) || isAdmin());
      allow list: if false;

      allow create: if isValidId(uid)
        && isPhoneVerifiedOwner(uid)
        && isValidCustomerProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      allow update: if isValidId(uid)
        && isSignedIn()
        && isValidCustomerProfile(incoming(), uid)
        && (
          isAdmin()
          || (
            isPhoneVerifiedOwner(uid)
            && incoming().uid == existing().uid
            && incoming().phone == existing().phone
            && incoming().phoneVerified == existing().phoneVerified
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          )
        );

      allow delete: if isValidId(uid) && isAdmin();
    }
  }
}
